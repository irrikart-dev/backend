NODE_ENV=development
PORT=4000

# --- Database (Prisma / Neon) ---
DATABASE_URL=
DIRECT_URL=

# --- Redis (BullMQ queues) ---
REDIS_URL=

# --- Razorpay ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- Shiprocket ---
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=

# --- Firebase Admin SDK — verifies user ID tokens, manages accounts ---
# Firebase Console -> Project settings -> Service accounts -> Generate new
# private key. Paste its three fields (FIREBASE_PRIVATE_KEY keeps its "\n" literal).
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# --- MSG91 (SMS/OTP) ---
MSG91_AUTH_KEY=
MSG91_EMAIL_DOMAIN=

# --- Supabase Storage — product/category image uploads ---
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_STORAGE_BUCKET=irrikart-uploads
