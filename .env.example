NODE_ENV=development
PORT=4000

# --- Database (Prisma / Neon) ---
DATABASE_URL=
DIRECT_URL=

# --- Sentry (errors + tracing) — unset = SDK inert ---
SENTRY_DSN=

# --- Razorpay ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- Order rules (defaults shown) ---
COD_ENABLED=false
COD_MAX_ORDER_AMOUNT=5000
ORDER_CANCEL_WINDOW_HOURS=24
ORDER_PAYMENT_TIMEOUT_MINUTES=30
RETURN_WINDOW_DAYS=7

# --- Shiprocket ---
SHIPROCKET_API_EMAIL=
SHIPROCKET_API_PASSWORD=

# --- Firebase Admin SDK — verifies user ID tokens, manages accounts ---
# Firebase Console -> Project settings -> Service accounts -> Generate new
# private key. Paste its three fields (FIREBASE_PRIVATE_KEY keeps its "\n" literal).
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# --- MSG91 (SMS/OTP + email) ---
MSG91_AUTH_KEY=
# verified sending domain, e.g. q7otcf.mailer91.com
MSG91_EMAIL_DOMAIN=
# optional, defaults to no-reply@MSG91_EMAIL_DOMAIN
MSG91_EMAIL_FROM=
# template id for order/return/refund emails (vars: name, title, body, order_number); blank = no emails
MSG91_TEMPLATE_TRANSACTIONAL=

# --- Supabase Storage — product/category image uploads ---
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_STORAGE_BUCKET=irrikart-uploads
