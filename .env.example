PORT=4000
NODE_ENV=development

# Signs admin dashboard sessions. MUST be replaced in any deployed environment.
JWT_SECRET=irrikart-dev-secret-change-me
JWT_EXPIRES_IN=12h

# Dummy phase-1 admin. Replace with a real user store before going live.
ADMIN_EMAIL=admin@irrikart.in
ADMIN_PASSWORD=Admin@123
ADMIN_NAME=IrriKart Admin

# Comma-separated origins allowed to call the API (admin dashboard, web store).
# A single "*" allows any origin — handy for local dev, never use it in production.
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175,http://localhost:3000

# --- Sign-up email verification (OTP) ---
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
SIGNUP_TOKEN_TTL=10m

# SMTP — delivers the OTP email. Leave blank in development and the code is
# logged to the server console instead. REQUIRED in production (server
# refuses to boot without it). Example values for Gmail with an App Password:
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_USER=you@gmail.com
#   SMTP_PASS=<16-character app password>
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=IrriKart <no-reply@irrikart.in>

# --- Firebase Admin SDK — creates the real account once the email is verified ---
# Firebase Console -> Project settings -> Service accounts -> Generate new
# private key. Either point at the downloaded JSON file...
FIREBASE_SERVICE_ACCOUNT_PATH=
# ...or paste its three fields directly (handy for hosts with no file storage,
# e.g. Render/Vercel env vars). FIREBASE_PRIVATE_KEY keeps its "\n" literal.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
