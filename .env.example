PORT=4000
NODE_ENV=development

# Signs admin dashboard sessions. MUST be replaced in any deployed environment.
JWT_SECRET=irrikart-dev-secret-change-me
JWT_EXPIRES_IN=12h

# Dummy phase-1 admin. Replace with a real user store before going live.
ADMIN_EMAIL=admin@irrikart.in
ADMIN_PASSWORD=Admin@123
ADMIN_NAME=IrriKart Admin

# Comma-separated origins allowed to call the API (admin dashboard, web store).
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175,http://localhost:3000
