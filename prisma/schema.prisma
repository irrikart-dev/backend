generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL") // Neon pooled (PgBouncer) connection — used at runtime
  directUrl = env("DIRECT_URL")   // Neon direct connection — used by prisma migrate only
}

// each module owns its own models below.
// keep model ownership 1:1 with src/modules/<name> to preserve the module boundary.

// ============================================================
// auth — src/modules/auth
// ============================================================

enum UserRole {
  CUSTOMER
  ADMIN
}

enum UserStatus {
  ACTIVE
  BLOCKED
}

// identity and session state both live in Firebase Auth now — this table is a synced
// mirror, not the source of truth. firebaseUid is what every request actually
// authenticates against; phone/email are copied down from the verified token for
// display/business use only, never checked at login time.
model User {
  id          String     @id @default(cuid())
  firebaseUid String     @unique
  phone       String?    @unique // customers sign in by phone; admins may be email/password-only
  email       String?    @unique
  name        String?
  role        UserRole   @default(CUSTOMER)
  status      UserStatus @default(ACTIVE)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  addresses     Address[]
  deviceTokens  DeviceToken[]
  carts         Cart[]
  orders        Order[]
  wishlist      WishlistItem[]
  recentlyViewed RecentlyViewed[]
  reviews       Review[]
  rfqRequests   RfqRequest[]
  notifications Notification[]
  couponUsages  CouponUsage[]

  // every list of a user's own rows filters by userId then sorts by time —
  // covered case-by-case on the child tables (orders, notifications, etc).
  @@index([status])
}

model Address {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  line1     String
  line2     String?
  city      String
  state     String
  pincode   String
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
  // serviceability checks and admin lookups filter by pincode directly
  @@index([pincode])
}

model DeviceToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  fcmToken  String   @unique
  platform  String
  createdAt DateTime @default(now())

  @@index([userId])
}

// ============================================================
// catalog — src/modules/catalog
// ============================================================

model Category {
  id        String     @id @default(cuid())
  parentId  String?
  parent    Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children  Category[] @relation("CategoryTree")
  name      String
  slug      String     @unique
  blurb     String?
  imageUrl  String?
  products  Product[]

  // category-tree walk: "all children of X"
  @@index([parentId])
}

model Brand {
  id       String    @id @default(cuid())
  name     String
  slug     String    @unique
  products Product[]
}

model Product {
  id          String    @id @default(cuid())
  categoryId  String
  category    Category  @relation(fields: [categoryId], references: [id])
  brandId     String?
  brand       Brand?    @relation(fields: [brandId], references: [id])
  title       String
  slug        String    @unique
  tagline     String?
  description String?
  features    String[]  @default([])
  specs       Json?
  rating      Float     @default(0)
  reviewCount Int       @default(0)
  inStock     Boolean   @default(true)
  active      Boolean   @default(true)
  source      String    @default("admin") // seed | admin
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  variants       ProductVariant[]
  images         ProductImage[]
  wishlistedBy   WishlistItem[]
  recentlyViewed RecentlyViewed[]
  reviews        Review[]
  rfqRequests    RfqRequest[]

  // catalog browse: filter by category + only live products, newest first
  @@index([categoryId, active, createdAt])
  @@index([brandId])
}

model ProductVariant {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  sku       String  @unique
  size      String?
  color     String?
  unit      String  @default("piece") // piece | dozen | carton
  price     Decimal @db.Decimal(10, 2)
  stock     Int     @default(0)
  reserved  Int     @default(0) // held by orders not yet CAPTURED; available = stock - reserved

  cartItems      CartItem[]
  orderItems     OrderItem[]
  inventoryMoves InventoryLedger[]

  @@index([productId])
  // price/stock filter on listing pages
  @@index([price])
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  position  Int     @default(0)

  @@index([productId, position])
}

// audit trail for every stock change — reservation, order, return, manual admin edit
model InventoryLedger {
  id        String   @id @default(cuid())
  variantId String
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  changeQty Int
  reason    String // reserve | release | order | return | manual
  refType   String?
  refId     String?
  createdAt DateTime @default(now())

  // stock history for one SKU, most recent first
  @@index([variantId, createdAt])
}

// ============================================================
// search & discovery — src/modules/catalog (read-side)
// ============================================================

model WishlistItem {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, productId])
}

model RecentlyViewed {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  viewedAt  DateTime @default(now())

  // "last N viewed by this user" — the exact query shape this table exists for
  @@index([userId, viewedAt])
}

// ============================================================
// cart — src/modules/cart
// ============================================================

enum CartStatus {
  ACTIVE
  MERGED
  CONVERTED
}

model Cart {
  id          String     @id @default(cuid())
  userId      String
  user        User       @relation(fields: [userId], references: [id])
  status      CartStatus @default(ACTIVE)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  items CartItem[]

  @@index([userId, status])
}

model CartItem {
  id             String         @id @default(cuid())
  cartId         String
  cart           Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variantId      String
  variant        ProductVariant @relation(fields: [variantId], references: [id])
  quantity       Int
  priceSnapshot  Decimal        @db.Decimal(10, 2)

  @@unique([cartId, variantId])
}

// ============================================================
// orders — src/modules/orders
// ============================================================

// single-vendor storefront (IrriKart is the only seller) — no per-vendor split,
// commission, or payout tracking; one order ships and fulfills as one unit
enum OrderStatus {
  PLACED
  CONFIRMED
  PACKED
  SHIPPED
  DELIVERED
  CANCELLED
  RETURNED
}

model Order {
  id          String      @id @default(cuid())
  orderNumber String      @unique
  userId      String
  user        User        @relation(fields: [userId], references: [id])
  status      OrderStatus @default(PLACED)
  totalAmount Decimal     @db.Decimal(10, 2)
  createdAt   DateTime    @default(now())

  items        OrderItem[]
  payments     Payment[]
  refunds      Refund[]
  shipment     Shipment?
  couponUsages CouponUsage[]

  // order history screen: this user's orders, newest first
  @@index([userId, createdAt])
  // admin console: filter by status, sorted by recency
  @@index([status, createdAt])
}

model OrderItem {
  id          String         @id @default(cuid())
  orderId     String
  order       Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variantId   String
  variant     ProductVariant @relation(fields: [variantId], references: [id])
  quantity    Int
  unitPrice   Decimal        @db.Decimal(10, 2)
  totalPrice  Decimal        @db.Decimal(10, 2)

  review Review?

  @@index([orderId])
  @@index([variantId])
}

// ============================================================
// payments — src/modules/payments
// ============================================================

enum PaymentStatus {
  CREATED
  CAPTURED
  FAILED
}

model Payment {
  id                String        @id @default(cuid())
  orderId           String
  order             Order         @relation(fields: [orderId], references: [id])
  provider          String        @default("razorpay") // matches STORAGE_PROVIDER convention — see PaymentProviderFactory
  providerOrderId   String        @unique
  providerPaymentId String?       @unique
  status            PaymentStatus @default(CREATED)
  amount            Decimal       @db.Decimal(10, 2)
  method            String?
  createdAt         DateTime      @default(now())

  refunds Refund[]

  @@index([orderId])
  // webhook handler's first move: "have I processed this payment_id already?"
  // providerPaymentId unique index above is what makes that lookup O(1) and idempotent
}

model Refund {
  id               String   @id @default(cuid())
  paymentId        String
  payment          Payment  @relation(fields: [paymentId], references: [id])
  orderId          String
  order            Order    @relation(fields: [orderId], references: [id])
  razorpayRefundId String   @unique
  status           String
  amount           Decimal  @db.Decimal(10, 2)
  createdAt        DateTime @default(now())

  @@index([paymentId])
  @@index([orderId])
}

// ============================================================
// shipping — src/modules/shipping
// ============================================================

enum ShipmentStatus {
  CREATED
  IN_TRANSIT
  DELIVERED
  RTO
  FAILED
}

model Shipment {
  id                  String         @id @default(cuid())
  orderId             String         @unique
  order               Order          @relation(fields: [orderId], references: [id])
  shiprocketShipmentId String        @unique
  awbNumber           String?        @unique
  status              ShipmentStatus @default(CREATED)
  createdAt           DateTime       @default(now())

  trackingEvents ShipmentTrackingEvent[]

  // RTO / failed-delivery admin queue
  @@index([status])
}

model ShipmentTrackingEvent {
  id         String   @id @default(cuid())
  shipmentId String
  shipment   Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  status     String
  description String?
  occurredAt DateTime

  // shipment detail timeline, chronological
  @@index([shipmentId, occurredAt])
}

// ============================================================
// rfq — src/modules/rfq
// ============================================================

model RfqRequest {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id])
  productId    String?
  product      Product? @relation(fields: [productId], references: [id])
  quantity     Int
  requirements String?
  targetPrice  Decimal? @db.Decimal(10, 2)
  createdAt    DateTime @default(now())

  // admin RFQ inbox, newest first
  @@index([createdAt])
  @@index([userId])
}

// ============================================================
// discounts — src/modules/discounts
// ============================================================

enum CouponType {
  FLAT
  PERCENT
}

model Coupon {
  id             String     @id @default(cuid())
  code           String     @unique
  type           CouponType
  value          Decimal    @db.Decimal(10, 2)
  minCartValue   Decimal?   @db.Decimal(10, 2)
  usageLimit     Int?
  perUserLimit   Int?
  expiresAt      DateTime?
  createdAt      DateTime   @default(now())

  usages CouponUsage[]

  @@index([expiresAt])
}

model CouponUsage {
  id       String   @id @default(cuid())
  couponId String
  coupon   Coupon   @relation(fields: [couponId], references: [id])
  userId   String
  user     User     @relation(fields: [userId], references: [id])
  orderId  String
  order    Order    @relation(fields: [orderId], references: [id])
  usedAt   DateTime @default(now())

  // per-user usage-limit check at checkout — must be fast, it's on the hot path
  @@index([couponId, userId])
}

// ============================================================
// reviews — src/modules/reviews
// ============================================================

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

model Review {
  id          String       @id @default(cuid())
  productId   String
  product     Product      @relation(fields: [productId], references: [id])
  userId      String
  user        User         @relation(fields: [userId], references: [id])
  orderItemId String       @unique // gates review to a delivered purchase, one review per item
  orderItem   OrderItem    @relation(fields: [orderItemId], references: [id])
  rating      Int
  comment     String?
  status      ReviewStatus @default(PENDING)
  createdAt   DateTime     @default(now())

  // product page: approved reviews, newest first
  @@index([productId, status, createdAt])
}

// ============================================================
// notifications — src/modules/notifications
// ============================================================

model Notification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  body      String
  type      String
  readAt    DateTime?
  createdAt DateTime  @default(now())

  // notification center: unread-first, newest-first, for one user
  @@index([userId, readAt, createdAt])
}
